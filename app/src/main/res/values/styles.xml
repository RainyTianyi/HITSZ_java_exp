<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101923</item>
        <item name="android:colorAccent">#73DBF2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="DifficultyButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:backgroundTint">#284754</item>
        <item name="android:textColor">#F1F7FA</item>
        <item name="android:textSize">18sp</item>
    </style>
